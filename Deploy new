/* ============================================================
   MYVIDEO-STYLE HERO + POSTER STRIP (streaming-site layout)
   ============================================================ */
.mv-hero{position:relative;border-radius:20px;overflow:hidden;margin:2px 0 20px;
  min-height:310px;display:flex;align-items:flex-end;cursor:pointer;isolation:isolate;
  border:1px solid rgba(255,255,255,.14);animation:rise .45s backwards}
.mv-art{position:absolute;inset:0;z-index:-1}
.mv-art img{width:100%;height:100%;object-fit:cover;transform:scale(1.07);
  transition:transform 6s ease}
.mv-hero:hover .mv-art img{transform:scale(1.13)}
.mv-hero::after{content:"";position:absolute;inset:0;
  background:
    linear-gradient(90deg,rgba(5,6,16,.94) 6%,rgba(5,6,16,.6) 45%,rgba(5,6,16,.12) 78%),
    linear-gradient(0deg,rgba(5,6,16,.88),transparent 55%)}
.mv-fire{position:absolute;right:-70px;top:-90px;width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle,rgba(255,110,30,.4),transparent 62%);filter:blur(12px);z-index:-1;
